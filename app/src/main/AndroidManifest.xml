<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No storage/camera/network permissions are requested. Images arrive via
      content:// URIs (share sheet / Photo Picker), which grant temporary,
      scoped read access without any permission of ours. See docs/PRIVACY.md.
    -->

    <application
        android:name=".AiCheckApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiCheck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AiCheck">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Share sheet entry point: "Share" -> AI Check from any app. Both SEND
              and SEND_MULTIPLE are declared: several share panels (notably Samsung's
              Gallery "Share via" sheet) dispatch SEND_MULTIPLE even for a single
              selected item, and an app that only declares SEND simply never appears
              for those sources. Only the first item is analyzed on a multi-select
              share; batch analysis is future scope (see docs/ROADMAP.md).
              video/* is accepted alongside image/* so Reels/Shorts-style video
              shares route in too (see AnalyzeVideoUseCase).
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!--
              Opening a local image file directly (e.g. a file manager "Open with").
              No BROWSABLE category: this isn't a web/app-link, only ever a local
              content:// or file:// URI from another on-device app. Schemes are
              listed explicitly (rather than relying on the platform's documented
              content:/file: default for a scheme-less <data> element) so Android
              Lint's AppLinkUrlError check can see this is intentional, not a
              malformed deep link.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="image/*" />
                <data android:scheme="file" android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Grants temporary read access to the generated shareable result-card PNG. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
